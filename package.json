{
  "name": "uddy-eight-seconds",
  "version": "0.1.0",
  "private": true,
  "description": "Uddy: Eight Seconds — Uddingston Hockey Club browser-first 3D field-hockey shoot-out vertical slice (TypeScript, Vite, Babylon.js WebGPU/WebGL2).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:rules": "python .agents/skills/hockey-rules-verification/scripts/verify_rules_math.py",
    "verify:assets": "python .agents/skills/uddingston-asset-production/scripts/validate_asset_manifest.py docs/asset-register/asset-and-licence-register.md",
    "benchmark": "node scripts/run_benchmarks_and_proofs.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/materials": "^8.0.0"
  },
  "devDependencies": {
    "playwright": "^1.52.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
